<?xml version="1.0"?>
<!-- Prefab UR10e+Robotiq beside a simple 2-DOF DKP (yaw + tilt) workpiece positioner.
     Tip path: world → UR → tool0. DKP is a side branch (Plan needs Motus Robot AllDrivers).
     Mesh paths resolve next to ur10e_robotiq.urdf. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur10e_with_dkp">
  <link name="world"/>

  <!-- DKP: Z-yaw then Y-tilt table, ~1 m in front of the arm. -->
  <link name="dkp_base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.18"/></geometry>
      <material name="dkp_base"><color rgba="0.35 0.35 0.38 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder length="0.10" radius="0.18"/></geometry>
    </collision>
  </link>

  <link name="dkp_yaw_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder length="0.08" radius="0.12"/></geometry>
      <material name="dkp_yaw"><color rgba="0.2 0.55 0.45 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder length="0.08" radius="0.12"/></geometry>
    </collision>
  </link>

  <link name="dkp_tilt_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.45 0.30 0.06"/></geometry>
      <material name="dkp_table"><color rgba="0.25 0.65 0.50 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.45 0.30 0.06"/></geometry>
    </collision>
  </link>

  <joint name="dkp_base_fixed" type="fixed">
    <parent link="world"/>
    <child link="dkp_base_link"/>
    <origin xyz="1.05 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="dkp_yaw" type="revolute">
    <parent link="dkp_base_link"/>
    <child link="dkp_yaw_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" velocity="1.5"/>
  </joint>

  <joint name="dkp_tilt" type="revolute">
    <parent link="dkp_yaw_link"/>
    <child link="dkp_tilt_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.0472" upper="1.0472" velocity="1.0"/>
  </joint>

  <xacro:include filename="ur10e_robotiq.urdf"/>

  <joint name="ur_world_mount" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
