+namespace Motus.Core;
+
+/// <summary>Traceability anchors for mobile-base planning models.</summary>
+public static class MobilityMethodRefs
+{
+    /// <summary>
+    /// LaValle, Planning Algorithms, Cambridge University Press, 2006.
