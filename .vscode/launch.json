{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rhino 8 — Motus (Debug, Windows)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-debug",
      "program": "C:/Program Files/Rhino 8/System/Rhino.exe",
      "args": "/netcore /nosplash",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": false,
      "stopAtEntry": false,
      "env": {
        "RHINO_PACKAGE_DIRS": "${workspaceFolder}/src/Motus.GH/bin/Debug/net8.0-windows"
      }
    },
    {
      "name": "Rhino 8 — Motus (Debug, macOS)",
      "type": "coreclr",
      "request": "attach",
      "processName": "Rhinoceros",
      "preLaunchTask": "debug-rhino",
      "justMyCode": false
    },
    {
      "name": "Attach Rhinoceros",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
