<Project>
  <!--
    Opt-in local Motus.NET: -p:UseMotusNetProjectReference=true
    (or ./build.ps1 -UseLocal). Default is NuGet — VS cannot restore
    ProjectReferences that are outside Motus.Grasshopper.slnx.
  -->
  <PropertyGroup>
    <!-- Sibling ../../Motus.NET (CI/desktop) or in-repo Motus.NET/ (cloud agent). -->
    <MotusNetSiblingCandidateA>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Motus.NET\'))</MotusNetSiblingCandidateA>
    <MotusNetSiblingCandidateB>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Motus.NET\'))</MotusNetSiblingCandidateB>
    <MotusNetSiblingRoot Condition="Exists('$(MotusNetSiblingCandidateA)src\Motus.Core\Motus.Core.csproj')">$(MotusNetSiblingCandidateA)</MotusNetSiblingRoot>
    <MotusNetSiblingRoot Condition="'$(MotusNetSiblingRoot)' == ''">$(MotusNetSiblingCandidateB)</MotusNetSiblingRoot>
    <UseMotusNetProjectReference Condition="'$(UseMotusNetProjectReference)' == ''">false</UseMotusNetProjectReference>
    <MotusNetVersion Condition="'$(UseMotusNetProjectReference)' == 'true'">0.14.0-local</MotusNetVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseMotusNetProjectReference)' == 'true' and '$(MSBuildProjectName)' == 'Motus.GH'">
    <ProjectReference Include="$(MotusNetSiblingRoot)src\Motus.Core\Motus.Core.csproj" />
    <ProjectReference Include="$(MotusNetSiblingRoot)src\Motus.Geometry\Motus.Geometry.csproj" />
    <ProjectReference Include="$(MotusNetSiblingRoot)src\Motus.Presets\Motus.Presets.csproj" />
    <ProjectReference Include="$(MotusNetSiblingRoot)src\Motus.OMPL.NET\Motus.OMPL.NET.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseMotusNetProjectReference)' == 'true' and '$(MSBuildProjectName)' == 'QaSmoke'">
    <ProjectReference Include="$(MotusNetSiblingRoot)src\Motus.Core\Motus.Core.csproj" />
    <ProjectReference Include="$(MotusNetSiblingRoot)src\Motus.Geometry\Motus.Geometry.csproj" />
    <ProjectReference Include="$(MotusNetSiblingRoot)src\Motus.Presets\Motus.Presets.csproj" />
    <ProjectReference Include="$(MotusNetSiblingRoot)src\Motus.OMPL.NET\Motus.OMPL.NET.csproj" />
  </ItemGroup>
</Project>
